# Copy this file to `.env` (never commit `.env`) and adjust the values.
POSTGRES_DB=developer_evaluation
POSTGRES_USER=developer
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# HMAC key used to sign JWT tokens (at least 32 characters).
JWT_SECRET_KEY=change-me-to-a-random-secret-with-at-least-32-chars
