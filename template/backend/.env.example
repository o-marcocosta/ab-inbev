# Local-only defaults: `cp .env.example .env` is enough to run the project.
# Change every password and the JWT key before using this anywhere other than a local machine.
POSTGRES_DB=developer_evaluation
POSTGRES_USER=developer
POSTGRES_PASSWORD=local-dev-password
POSTGRES_HOST_PORT=5432

# Messageria
RABBITMQ_USER=developer
RABBITMQ_PASSWORD=local-dev-password
RABBITMQ_HOST_PORT=5672
# Management UI: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# HMAC key used to sign JWT tokens (at least 32 characters).
JWT_SECRET_KEY=local-dev-jwt-secret-key-not-for-production
